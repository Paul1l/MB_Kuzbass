{
  "name": "mb-kuzbass-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "import:catalog": "node scripts/import-catalog-images.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "build": "npm run generate:favicons && npm run optimize:images && vite build && node scripts/prepare-dist.mjs && node scripts/verify-build.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm run build && npm audit --audit-level=high",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sass": "^1.101.0",
    "sharp": "^0.35.3",
    "vite": "^8.1.4"
  }
}
